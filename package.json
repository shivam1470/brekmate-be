{
  "name": "@brekmate/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "dev": "node --import tsx src/local.ts",
    "check": "npm run typecheck && npm test && npm run contracts && npm run build",
    "contracts": "node --import tsx scripts/contracts.ts",
    "format": "prettier --write src test scripts adapters docs integration package.json tsconfig.json",
    "package": "npm run check && python3 scripts/package.py"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1152.0",
    "@aws-sdk/client-secrets-manager": "3.1152.0",
    "@aws-sdk/lib-dynamodb": "3.1152.0",
    "@fastify/aws-lambda": "6.4.2",
    "fastify": "5.12.7",
    "jose": "6.2.12",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
